@startuml
title Modele entite-association - Clinique (v2)

skinparam linetype ortho
hide circle

entity "Roles" as Roles {
  * id : INT <<PK>>
  --
  * nom : VARCHAR(255)
  description : VARCHAR(255)
}

entity "Utilisateurs" as Utilisateurs {
  * id : INT <<PK>>
  --
  * nom : VARCHAR(255)
  * email : VARCHAR(255) <<unique>>
  * mot_de_passe : VARCHAR(255)
  photo : VARCHAR(255)
  * roleId : INT <<FK>>
}

entity "Patients" as Patients {
  * id : INT <<PK>>
  --
  * utilisateurId : INT <<FK unique>>
  date_naissance : DATE
  sexe : VARCHAR(255)
  telephone : VARCHAR(255)
  adresse : VARCHAR(255)
  numero_assurance_maladie : VARCHAR(255)
  allergies : TEXT
  antecedents : TEXT
}

entity "Medecins" as Medecins {
  * id : INT <<PK>>
  --
  * utilisateurId : INT <<FK unique>>
  * departementId : INT <<FK>>
  * numero_licence : VARCHAR(255)
  telephone : VARCHAR(255)
  photo : VARCHAR(255)
}

entity "Departments" as Departments {
  * id : INT <<PK>>
  --
  * nom : VARCHAR(255)
  description : VARCHAR(255)
  image : VARCHAR(255)
}

entity "RendezVous" as RendezVous {
  * id : INT <<PK>>
  --
  * patientId : INT <<FK>>
  * medecinId : INT <<FK>>
  * date : DATE
  * heure : VARCHAR(255)
  * statut : VARCHAR(255)
}

entity "Traitements" as Traitements {
  * id : INT <<PK>>
  --
  * rendezVousId : INT <<FK>>
  description : VARCHAR(255)
  instructions : TEXT
  document : VARCHAR(255)
}

entity "JournalAcces" as JournalAcces {
  * id : INT <<PK>>
  --
  * utilisateurId : INT <<FK>>
  * patientId : INT <<FK>>
  * action : VARCHAR(255)
  * date : DATETIME
}

Roles ||--o| Utilisateurs : "a plusieurs"
Utilisateurs ||--o| Patients : "a au plus un profil"
Utilisateurs ||--o| Medecins : "a au plus un profil"
Departments ||--o| Medecins : "regroupe plusieurs"
Patients ||--o| RendezVous : "a plusieurs"
Medecins ||--o| RendezVous : "a plusieurs"
RendezVous ||--o| Traitements : "donne lieu a plusieurs"
Utilisateurs ||--o| JournalAcces : "consulte"
Patients ||--o| JournalAcces : "est consulte"

@enduml
